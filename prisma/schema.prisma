generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Core ──

model Company {
  id          String   @id @default(uuid())
  name        String
  trn         String?  @unique
  address     String?
  phone       String?
  email       String?
  logoUrl     String?
  currency    String   @default("AED")
  timezone    String   @default("Asia/Dubai")
  language    String   @default("en")
  vatPercent  Float    @default(5)
  invoicePrefix     String @default("INV-")
  quotationPrefix   String @default("QUO-")
  poPrefix          String @default("PO-")
  woPrefix          String @default("WO-")
  amcPrefix         String @default("AMC-")
  invoiceHeader     String?
  invoiceFooter     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  customers   Customer[]
  buildings   Building[]
  assets      Asset[]
  workOrders  WorkOrder[]
  invoices    Invoice[]
  amcs        AMC[]
  purchaseOrders PurchaseOrder[]
  expenses    Expense[]
  items       InventoryItem[]
  stockAdjustments StockAdjustment[]
  notifications Notification[]
  staff       Staff[]
  purchases   Purchase[]
}

model User {
  id          String   @id @default(uuid())
  companyId   String
  email       String   @unique
  password    String
  name        String
  phone       String?
  role        UserRole @default(TECHNICIAN)
  isActive    Boolean  @default(true)
  skills      String[] // e.g. ["HVAC", "Electrical"]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workOrders  WorkOrder[]
  fcmTokens   FcmToken[]
  expenses    Expense[] @relation("ExpenseCreatedBy")
  approvedExpenses Expense[] @relation("ExpenseApprovedBy")

  @@index([companyId])
  @@index([role])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  COORDINATOR
  TECHNICIAN
  ACCOUNTANT
  VIEWER
}

// ── Services ──

model ServiceCategory {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workOrders  WorkOrder[]
  assets      Asset[]
  amcs        AMC[]
}

// ── Customer Hierarchy ──

model Customer {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  email       String?
  phone       String?
  address     String?
  trn         String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  buildings   Building[]
  invoices    Invoice[]
  amcs        AMC[]
  workOrders  WorkOrder[]

  @@index([companyId])
}

model Building {
  id          String   @id @default(uuid())
  companyId   String
  customerId  String
  name        String
  address     String?
  city        String?
  emirate     String?
  latitude    Float?
  longitude   Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  flats       Flat[]
  assets      Asset[]
  workOrders  WorkOrder[]

  @@index([companyId])
  @@index([customerId])
}

model Flat {
  id          String   @id @default(uuid())
  buildingId  String
  unitNumber  String
  floor       Int?
  type        String?  // e.g. "1BHK", "2BHK", "Office"
  areaSqft    Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  assets      Asset[]
  workOrders  WorkOrder[]

  @@unique([buildingId, unitNumber])
  @@index([buildingId])
}

// ── Assets ──

model Asset {
  id                String   @id @default(uuid())
  companyId         String
  buildingId        String?
  flatId            String?
  serviceCategoryId String?
  assetNumber       String   @unique
  name              String
  description       String?
  manufacturer      String?
  model             String?
  serialNumber      String?
  location          String?
  installedDate     DateTime?
  warrantyExpiry    DateTime?
  status            AssetStatus @default(ACTIVE)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  building          Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  flat              Flat?    @relation(fields: [flatId], references: [id], onDelete: SetNull)
  serviceCategory   ServiceCategory? @relation(fields: [serviceCategoryId], references: [id], onDelete: SetNull)
  workOrders        WorkOrder[]
  amcs              AMC[]
  serviceHistory    AssetServiceHistory[]

  @@index([companyId])
  @@index([buildingId])
  @@index([flatId])
}

enum AssetStatus {
  ACTIVE
  UNDER_MAINTENANCE
  DECOMMISSIONED
}

model AssetServiceHistory {
  id          String   @id @default(uuid())
  assetId     String
  workOrderId String?
  action      String   // e.g. "PPM", "Repair", "Replacement"
  description String?
  performedAt DateTime @default(now())
  performedBy String?

  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
}

// ── AMC (Annual Maintenance Contract) ──

model AMC {
  id                String    @id @default(uuid())
  companyId         String
  customerId        String
  assetId           String?
  serviceCategoryId String?
  contractNumber    String    @unique
  startDate         DateTime
  endDate           DateTime
  value             Float
  paymentType       AMCPaymentType @default(LUMPSUM)
  ppmFrequency      Int       @default(3) // months between PPMs
  status            AMCStatus @default(ACTIVE)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  asset             Asset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)
  serviceCategory   ServiceCategory? @relation(fields: [serviceCategoryId], references: [id], onDelete: SetNull)
  ppmSchedules      PPMSchedule[]
  emiSchedules      EMISchedule[]

  @@index([companyId])
  @@index([customerId])
}

enum AMCPaymentType {
  LUMPSUM
  EMI
}

enum AMCStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

model PPMSchedule {
  id          String      @id @default(uuid())
  amcId       String
  scheduledAt DateTime
  completedAt DateTime?
  status      PPMStatus   @default(SCHEDULED)
  notes       String?
  workOrderId String?
  createdAt   DateTime    @default(now())

  amc         AMC         @relation(fields: [amcId], references: [id], onDelete: Cascade)

  @@index([amcId])
  @@index([status])
}

enum PPMStatus {
  SCHEDULED
  DUE
  OVERDUE
  COMPLETED
  SKIPPED
}

model EMISchedule {
  id          String      @id @default(uuid())
  amcId       String
  amount      Float
  dueDate     DateTime
  paidAt      DateTime?
  status      EMIStatus   @default(PENDING)
  invoiceId   String?
  createdAt   DateTime    @default(now())

  amc         AMC         @relation(fields: [amcId], references: [id], onDelete: Cascade)

  @@index([amcId])
  @@index([status])
}

enum EMIStatus {
  PENDING
  PAID
  OVERDUE
}

// ── Work Orders ──

model WorkOrder {
  id                String        @id @default(uuid())
  companyId         String
  customerId        String?
  buildingId        String?
  flatId            String?
  assetId           String?
  serviceCategoryId String?
  technicianId      String?
  woNumber          String        @unique
  title             String
  description       String?
  priority          Priority      @default(MEDIUM)
  status            WOStatus      @default(PENDING)
  scheduledDate     DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  actualCost        Float?
  customerNotes     String?
  technicianNotes   String?
  
  // Service Report Fields
  serviceReportNumber String?
  workPerformed       String?
  observations        String?
  materialsUsed       Json?
  clientSignature     String?
  technicianName      String?

  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer          Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  building          Building?     @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  flat              Flat?         @relation(fields: [flatId], references: [id], onDelete: SetNull)
  asset             Asset?        @relation(fields: [assetId], references: [id], onDelete: SetNull)
  serviceCategory   ServiceCategory? @relation(fields: [serviceCategoryId], references: [id], onDelete: SetNull)
  technician        User?         @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  quotation         Quotation?
  invoice           Invoice?

  @@index([companyId])
  @@index([technicianId])
  @@index([status])
  @@index([priority])
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WOStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

// ── Quotations ──

model Quotation {
  id          String   @id @default(uuid())
  workOrderId String   @unique
  quoteNumber String   @unique
  subtotal    Float
  vatAmount   Float
  total       Float
  status      QuoteStatus @default(DRAFT)
  validUntil  DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

// ── Inventory ──

model InventoryItem {
  id          String   @id @default(uuid())
  companyId   String
  sku         String
  name        String
  description String?
  unit        String   @default("pcs")
  quantity    Float    @default(0)
  minStock    Float    @default(0)
  costPrice   Float    @default(0)
  sellingPrice Float?
  location    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  itemsUsed   ItemUsed[]
  stockAdjustments StockAdjustment[]
  poItems     PurchaseOrderItem[]

  @@unique([companyId, sku])
  @@index([companyId])
}

model StockAdjustment {
  id          String   @id @default(uuid())
  companyId   String
  itemId      String
  quantityBefore Float
  quantityAfter  Float
  difference     Float
  reason      String
  notes       String?
  adjustedBy  String?
  createdAt   DateTime @default(now())

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([itemId])
}

model ItemUsed {
  id          String   @id @default(uuid())
  workOrderId String
  itemId      String
  quantity    Float
  unitCost    Float?
  totalCost   Float?
  createdAt   DateTime @default(now())

  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@index([itemId])
}

// ── Invoices & Payments ──

model Invoice {
  id          String   @id @default(uuid())
  companyId   String
  customerId  String
  workOrderId String?  @unique
  invoiceNumber String @unique
  issueDate   DateTime @default(now())
  dueDate     DateTime
  subtotal    Float
  vatRate     Float    @default(5)
  vatAmount   Float
  total       Float
  amountPaid  Float    @default(0)
  balanceDue  Float
  status      InvoiceStatus @default(DRAFT)
  notes       String?
  isVoid      Boolean  @default(false)
  voidReason  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  payments    Payment[]

  @@index([companyId])
  @@index([customerId])
  @@index([status])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  VOID
}

model Payment {
  id          String   @id @default(uuid())
  invoiceId   String
  amount      Float
  method      PaymentMethod @default(CASH)
  referenceNo String?
  paidAt      DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

enum PaymentMethod {
  CASH
  CHEQUE
  BANK_TRANSFER
  CREDIT_CARD
  ONLINE
}

// ── Purchase Orders ──

model PurchaseOrder {
  id          String   @id @default(uuid())
  companyId   String
  poNumber    String   @unique
  supplierName String
  supplierEmail String?
  supplierPhone String?
  subtotal    Float
  vatAmount   Float
  total       Float
  status      POStatus @default(DRAFT)
  notes       String?
  receivedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items       PurchaseOrderItem[]

  @@index([companyId])
}

model PurchaseOrderItem {
  id          String   @id @default(uuid())
  poId        String
  itemId      String?
  description String
  quantity    Float
  unitPrice   Float
  total       Float
  receivedQty Float    @default(0)

  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  item        InventoryItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([poId])
}

enum POStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CANCELLED
}

// ── Expenses ──

model Expense {
  id          String   @id @default(uuid())
  companyId   String
  category    String
  amount      Float
  description String?
  receiptUrl  String?
  status      ExpenseStatus @default(PENDING)
  createdById String
  approvedById String?
  expenseDate DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  approvedBy  User?    @relation("ExpenseApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([status])
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

// ── Notifications ──

model Notification {
  id          String   @id @default(uuid())
  companyId   String
  userId      String?
  title       String
  body        String
  type        NotificationType
  data        Json?    // payload for deep linking
  isRead      Boolean  @default(false)
  sentViaPush Boolean  @default(false)
  createdAt   DateTime @default(now())

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@index([isRead])
}

enum NotificationType {
  WORK_ORDER_ASSIGNED
  WORK_ORDER_DUE
  WORK_ORDER_OVERDUE
  PPM_DUE
  PPM_OVERDUE
  EMI_DUE
  EMI_OVERDUE
  AMC_EXPIRING
  AMC_EXPIRED
  LOW_STOCK
  INVOICE_OVERDUE
  GENERAL
}

// ── FCM Tokens ──

model FcmToken {
  id        String   @id @default(uuid())
  userId    String
  token     String
  deviceType String? // ios, android, web
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
}

// ── Staff (HR Module) ──

model Staff {
  id               String    @id @default(uuid())
  companyId        String
  firstName        String
  lastName         String
  photoUrl         String?
  jobTitle         String?
  nationality      String?
  phone            String?
  passportNumber   String?
  passportExpiry   DateTime?
  emiratesId       String?
  emiratesIdExpiry DateTime?
  visaNumber       String?
  visaExpiry       DateTime?
  insuranceProvider     String?
  insurancePolicyNumber String?
  insuranceExpiry       DateTime?
  createdAt        DateTime  @default(now())

  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ── Purchases (Bills / Direct Purchases) ──

model Purchase {
  id            String    @id @default(uuid())
  companyId     String
  supplierName  String?
  billNumber    String?
  purchaseDate  DateTime?
  dueDate       DateTime?
  workOrderId   String?
  assetId       String?
  items         Json?
  subtotal      Float?
  vatAmount     Float?
  totalAmount   Float?
  paymentStatus String?
  paymentMethod String?
  receiptUrl    String?
  createdAt     DateTime  @default(now())

  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}
